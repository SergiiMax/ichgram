{
  // tsconfig.json — настройки компилятора TypeScript (tsc) для бэкенда.
  // Используется: в редакторе (подсветка ошибок), в `npm run typecheck` (проверка типов)
  // и в `npm run build` (компиляция src/*.ts → dist/*.js для продакшена).
  // tsx в `npm run dev` тоже читает этот файл, но типы НЕ проверяет — только отрезает их.

  "compilerOptions": {
    /* ---------- Во что компилируем ---------- */

    // Версия JavaScript на выходе. Node 24 понимает современный JS,
    // поэтому понижать незачем: код в dist/ почти совпадает с исходным.
    "target": "ES2024",

    // Какие встроенные API JavaScript «существуют» для TS (Array.prototype.toSorted, Object.groupBy и т.п.).
    // Держим в паре с target — одинаковое значение.
    "lib": ["ES2024"],

    // Подключить типы Node.js из пакета @types/node (process, Buffer, http, fs…).
    // В новых TS (6+) типы из @types сами не подключаются — их нужно перечислить явно,
    // иначе будет ошибка «Cannot find name 'process'».
    "types": ["node"],

    /* ---------- Модули ---------- */

    // Синтаксис модулей на выходе — по правилам Node.js.
    // Так как в package.json стоит "type": "module", это будут ESM-модули (import/export).
    "module": "NodeNext",

    // Как искать импортируемые файлы — тоже по правилам Node.js.
    // Главное следствие: в импортах своих файлов обязательно расширение .js
    // (import { env } from './config/env.js'), даже если файл называется env.ts.
    // Без этого код работал бы в tsx, но падал бы после сборки в `node dist/server.js`.
    "moduleResolution": "NodeNext",

    // Импорты, которые нужны только для типов, пишем как `import type { ... }`.
    // Они полностью стираются при компиляции, остальные импорты остаются как есть.
    // Убирает класс ESM-ошибок «модуль загружен, а экспорта нет».
    "verbatimModuleSyntax": true,

    // Каждый файл должен компилироваться сам по себе, без знания о других файлах.
    // Это требование инструментов вроде tsx/esbuild, которые обрабатывают файлы по одному.
    "isolatedModules": true,

    // Считать каждый .ts файл модулем (а не «глобальным скриптом»),
    // даже если в нём пока нет ни одного import/export.
    "moduleDetection": "force",

    // Корректный импорт старых CommonJS-пакетов через `import x from 'pkg'`.
    // (allowSyntheticDefaultImports включается автоматически вместе с этой опцией.)
    "esModuleInterop": true,

    /* ---------- Пути и структура ---------- */

    // Где лежат исходники. Структура папок внутри src/ повторится в dist/.
    "rootDir": "./src",

    // Куда tsc кладёт скомпилированный JavaScript (папка в .gitignore).
    "outDir": "./dist",

    // ВАЖНО: алиасов "paths" здесь намеренно нет — tsc не переписывает пути
    // при компиляции, и `node dist/...` не нашёл бы такие импорты.

    /* ---------- Строгость проверок ---------- */

    // Включает весь набор строгих проверок: null/undefined, неявный any,
    // типы параметров функций и т.д. Главная польза TypeScript.
    "strict": true,

    // Ошибка, если функция возвращает значение не во всех ветках (забытый return).
    "noImplicitReturns": true,

    // Ошибка, если в switch case «проваливается» в следующий без break/return.
    "noFallthroughCasesInSwitch": true,

    // Ошибка, если имя файла в импорте отличается регистром (user.ts vs User.ts).
    // Windows регистр не различает, а Linux в Docker — различает. Ловим заранее.
    "forceConsistentCasingInFileNames": true,

    // Ошибка, если импорт «ради побочного эффекта» (import './x.js') указывает на несуществующий файл.
    "noUncheckedSideEffectImports": true,

    // Не проверять типы внутри node_modules: быстрее и без чужих ошибок.
    "skipLibCheck": true,

    /* ---------- Сборка и отладка ---------- */

    // Создавать .js.map рядом с .js: в ошибках продакшена номера строк
    // будут указывать на исходный .ts, а не на скомпилированный .js.
    "sourceMap": true,

    // Если есть ошибки типов — dist/ не создаётся.
    // Сломанный код не попадёт в Docker-образ.
    "noEmitOnError": true
  },

  // Какие файлы компилировать: все .ts в src/ и её подпапках (** — любая глубина).
  "include": ["src/**/*.ts"],

  // Что точно не трогать (явно, для читаемости — эти папки и так вне src/).
  "exclude": ["node_modules", "dist"]
}
